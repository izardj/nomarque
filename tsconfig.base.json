{
  "compilerOptions": {
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@nomarque/rules": ["./libs/rules/src/index.ts"],
      "@nomarque/data": ["./libs/data/src/index.ts"],
      "@nomarque/contracts": ["./libs/contracts/src/index.ts"],
      "@nomarque/db": ["./libs/db/src/index.ts"]
    }
  }
}
