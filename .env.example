# Copy this file to .env and adjust values as needed.
# The .env file is git-ignored and must never contain real secrets.

# PostgreSQL user created by the postgres image.
POSTGRES_USER=nomarque
# PostgreSQL password for that user.
POSTGRES_PASSWORD=nomarque
# Database created at first startup.
POSTGRES_DB=nomarque
# Host port mapped to PostgreSQL (5433 avoids a local PostgreSQL on 5432).
POSTGRES_PORT=5433
# Connection string used by the apps when running on the host.
DATABASE_URL=postgresql://nomarque:nomarque@localhost:5433/nomarque?schema=public

# Host port mapped to Redis (6380 avoids a local Redis on 6379).
REDIS_PORT=6380
# Redis connection string used by the apps when running on the host.
REDIS_URL=redis://localhost:6380

# SMTP host used for outgoing mail (Mailpit when running locally).
SMTP_HOST=localhost
# SMTP port exposed by Mailpit.
SMTP_PORT=1025
# SMTP user, leave empty for Mailpit.
SMTP_USER=
# SMTP password, leave empty for Mailpit.
SMTP_PASSWORD=
# Default sender address for outgoing mail.
MAIL_FROM="Nomarque <no-reply@nomarque.local>"

# Host port mapped to the Mailpit SMTP server.
MAILPIT_SMTP_PORT=1025
# Host port mapped to the Mailpit web UI (http://localhost:8025).
MAILPIT_UI_PORT=8025

# Host port mapped to the api container.
API_PORT=3000
# Host port mapped to the web container.
WEB_PORT=8080

# Public URL of the web app, used to build magic links.
APP_URL=http://localhost:4200
# Send cookies with the Secure flag; must be false over plain HTTP in local dev.
COOKIE_SECURE=false
