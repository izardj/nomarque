{
  "name": "reign-sim",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/reign-sim/src",
  "projectType": "application",
  "tags": ["scope:server", "type:tooling"],
  "targets": {
    "simulate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx tools/reign-sim/src/main.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/reign-sim/tsconfig.json"
      }
    }
  }
}
